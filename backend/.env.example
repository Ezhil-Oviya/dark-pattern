APP_NAME=Dark Pattern Compliance Auditor API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dark_pattern_auditor
JWT_SECRET_KEY=replace-with-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EVIDENCE_STORAGE_PATH=../storage/evidence
REPORT_STORAGE_PATH=../storage/reports
PLAYWRIGHT_HEADLESS=true
LOG_LEVEL=INFO
